# ==========================================
# Interview Assistant Frontend Environment
# ==========================================

# Backend FastAPI URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# LiveKit WebRTC Configuration (Client Connection)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional Face Detection WebSocket URL (defaults to backend host)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/face-detection/ws
