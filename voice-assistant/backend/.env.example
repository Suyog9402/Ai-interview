# ==========================================
# Interview Assistant Backend Environment
# ==========================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_assistant
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Security & Authentication
SECRET_KEY=generate-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LiveKit WebRTC Configuration (for Real-time Voice Agent)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Model Configuration (Multi-Provider Support: Groq, Gemini, OpenAI, Deepgram)
# Groq (Ultra-fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3

# Google Gemini (Dense embeddings and multimodal extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Deepgram Speech-To-Text & TTS
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2
TRANSCRIBER_PROVIDER=deepgram

# Optional OpenAI (Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Vector Store (ChromaDB - Local Directory Default)
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PATH=./db/vector_store
VECTOR_STORE_COLLECTION_RESUMES=resumes
VECTOR_STORE_COLLECTION_TRANSCRIPTS=transcripts
VECTOR_STORE_COLLECTION_JDS=job_descriptions

# RAG & Matching Parameters
MATCHING_DEFAULT_THRESHOLD=0.65
MATCHING_HARD_FILTER_ENABLED=true
RAG_RETRIEVAL_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_HYBRID_ALPHA=0.5

# Storage Configuration (Default: local filesystem)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# Optional Cloud Storage Adapters (Interface extensions)
# STORAGE_AZURE_ACCOUNT_NAME=
# STORAGE_AZURE_ACCOUNT_KEY=
# STORAGE_AZURE_CONTAINER=
# STORAGE_AWS_ACCESS_KEY=
# STORAGE_AWS_SECRET_KEY=
# STORAGE_AWS_BUCKET=
# STORAGE_AWS_REGION=
